# The Dockerfile runs `npm install --omit=dev` in this directory. Without
# legacy-peer-deps, npm would auto-install this extension's (and its
# dependency's) `@earendil-works/pi-coding-agent` peer into
# node_modules — a second, version-floating copy of the very package
# pi-coding-agent that already runs in this container.
#
# At runtime no local copy is needed: pi's extension loader (jiti) aliases
# `@earendil-works/pi-coding-agent` to its own entry point, so imports in
# `pi-auto-compact/extensions/auto-compact.ts` resolve to the host runtime.
# The peerDependencies entry is for IDEs/typecheck only.
legacy-peer-deps=true